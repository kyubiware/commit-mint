{
	"name": "@kyubiware/commit-mint",
	"version": "0.9.3",
	"description": "🌿 AI-powered git commit tool — auto-group changed files, generate messages, run pre-commit checks",
	"type": "module",
	"bin": {
		"cmint": "./dist/bin.mjs"
	},
	"files": [
		"dist"
	],
	"scripts": {
		"build": "tsdown src/bin.ts --format esm --dts --clean",
		"dev": "tsx src/bin.ts",
		"dev:auto": "tsx src/bin.ts -a",
		"dev:debug": "tsx src/bin.ts --debug",
		"lint": "biome check .",
		"lint:fix": "biome check --write --unsafe .",
		"typecheck": "tsc --noEmit",
		"test": "vitest run",
		"test:coverage": "vitest run --coverage",
		"test:watch": "vitest --watch",
		"release:patch": "bash scripts/release.sh patch",
		"release:minor": "bash scripts/release.sh minor",
		"release:major": "bash scripts/release.sh major",
		"prepublishOnly": "npm run build",
		"publish:cmint": "cd packages/cmint && npm publish"
	},
	"keywords": [
		"git",
		"commit",
		"hooks",
		"pre-commit",
		"ai",
		"groq",
		"conventional-commits",
		"cli"
	],
	"author": "kyubiware",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "https://github.com/kyubiware/commit-mint.git"
	},
	"dependencies": {
		"@clack/prompts": "^1.4.0",
		"cleye": "^1.3.4",
		"execa": "^9.6.0",
		"groq-sdk": "^0.32.0",
		"ini": "^5.0.0",
		"jiti": "^2.7.0",
		"kolorist": "^1.8.0",
		"picomatch": "^4.0.4",
		"semver": "^7.7.2"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.0.0",
		"@types/ini": "^4.1.1",
		"@types/semver": "^7.7.1",
		"@vitest/coverage-v8": "^3.2.4",
		"tsdown": "^0.22.0",
		"tsx": "^4.22.2",
		"typescript": "^5.9.2",
		"vitest": "^3.2.1"
	}
}
